# Reproduction outputs (regenerated by run_all.py)
outputs/*
!outputs/.gitkeep

# Real data (NOT redistributed — see data/README.md)
data/*.mat
data/*.zip

# Python cruft
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Lean build artifacts (lake build PATP pulls Mathlib into .lake/)
.lake/
*.olean
*.ilean
*.trace

# LaTeX cruft (if a figure is compiled locally)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# OS cruft
.DS_Store
Thumbs.db
